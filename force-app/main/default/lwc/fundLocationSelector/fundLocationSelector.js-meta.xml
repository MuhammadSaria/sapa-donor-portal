<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Fund &amp; Location Selector</masterLabel>
    <description>Custom reactive lookup and location picklist</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="selectedFundId" type="String" label="Output: Selected Fund ID" role="outputOnly"/>
            <property name="selectedFundName" type="String" label="Output: Selected Fund Name" role="outputOnly"/>
            <property name="selectedLocation" type="String" label="Output: Selected Location" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>