<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Bell and mobile notification to the Stripe Support group, opening the log record.</description>
        <name>Send_Bell_Notification</name>
        <label>Send Bell Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector>
            <targetReference>Send_Email_Alert</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Remember_Bell_Error</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_Notification_Type.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>recipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <elementReference>NotificationTitle</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>NotificationBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <actionCalls>
        <description>Email alert to the Stripe Support group from the org-wide address.</description>
        <name>Send_Email_Alert</name>
        <label>Send Email Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Stripe_Failure_Log__c.Stripe_Failure_Alert</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Has_Notification_Error</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Remember_Email_Error</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Stripe_Failure_Log__c.Stripe_Failure_Alert</nameSegment>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Group_Recipient</name>
        <label>Add Group Recipient</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Support_Group.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Bell_Notification</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Ends the flow quietly if even the error could not be saved, so the log itself is never rolled back.</description>
        <name>Notification_Error_Not_Saved</name>
        <label>Notification Error Not Saved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>errorText</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Remember_Bell_Error</name>
        <label>Remember Bell Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BellErrorText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Email_Alert</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Remember_Email_Error</name>
        <label>Remember Email Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>EmailErrorText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Save_Notification_Error</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Remember_Lookup_Error</name>
        <label>Remember Lookup Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LookupErrorText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Save_Notification_Error</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Notification_Error</name>
        <label>Has Notification Error?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Notification_Error_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>errorText</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Notification_Error</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Alerts the Stripe Support group (bell + email) when a Stripe Failure Log is created, or when a resolved failure happens again and is reopened. Only for logs whose reason code is not muted in Stripe_Failure_Setting__mdt (Notify__c). Delivery problems are written to Notification_Error__c.</description>
    <environments>Default</environments>
    <formulas>
        <name>BellErrorText</name>
        <dataType>String</dataType>
        <expression>&quot;Bell notification failed: &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>EmailErrorText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!errorText}), &quot;&quot;, {!errorText} &amp; &quot; | &quot;) &amp; &quot;Email alert failed: &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>LookupErrorText</name>
        <dataType>String</dataType>
        <expression>&quot;Notification setup lookup failed: &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>NotificationBody</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; &quot; - &quot; &amp; TEXT({!$Record.Reason_Code__c}) &amp; &quot;: &quot; &amp; {!$Record.Failure_Reason__c}</expression>
    </formulas>
    <formulas>
        <name>NotificationErrorForField</name>
        <dataType>String</dataType>
        <expression>LEFT({!errorText}, 255)</expression>
    </formulas>
    <formulas>
        <name>NotificationTitle</name>
        <dataType>String</dataType>
        <expression>&quot;Stripe failure: &quot; &amp; TEXT({!$Record.Failure_Source__c})</expression>
    </formulas>
    <interviewLabel>Stripe Failure Log Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stripe Failure Log Notify</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Notification_Type</name>
        <label>Get Notification Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Support_Group</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Remember_Lookup_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Stripe_Failure_Alert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Support_Group</name>
        <label>Get Support Group</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Add_Group_Recipient</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Remember_Lookup_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Stripe_Support</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Regular</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Keeps a failed notification visible on the log itself.</description>
        <name>Save_Notification_Error</name>
        <label>Save Notification Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Notification_Error_Not_Saved</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Notification_Error__c</field>
            <value>
                <elementReference>NotificationErrorForField</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Notification_Type</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Notify__c}, OR(ISNEW(), AND(ISCHANGED({!$Record.Status__c}), ISPICKVAL({!$Record.Status__c}, &quot;New&quot;), ISPICKVAL(PRIORVALUE({!$Record.Status__c}), &quot;Resolved&quot;))))</filterFormula>
        <object>Stripe_Failure_Log__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>errorText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
