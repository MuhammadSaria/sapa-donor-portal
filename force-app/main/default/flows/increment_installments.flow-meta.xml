    <decisions>
        <name>Do_Tributes_Exist</name>
        <label>Do Tributes Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Tributes_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_1st_Donation_Tributes</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Tributes</targetReference>
            </connector>
            <label>Yes, Tributes Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Fup_donation</name>
        <label>Fup donation?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Recurring_Allocation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FundraiseUpId__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Values</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_R_single_Donation_Data</name>
        <label>New R single Donation Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>New_R_Single_donation_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_New_R_single_Donation_Data</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Created_From_Flow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Donation_Data</targetReference>
            </connector>
            <label>Outcome 1 of New R single Donation Data</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_R_Single_donation_Name</name>
        <label>New R Single donation Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Previous_Recurring_Donations</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Created From Flow True</defaultConnectorLabel>
        <rules>
            <name>created_form_flow_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Created_From_Flow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_1st_single_Donation.FUp_Donation_ID__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Change_Name</targetReference>
            </connector>
            <label>Created Form Flow(False)</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determine the next action based on existing recurring donations.</description>
        <name>Previous_Donation_Decision</name>
        <label>Previous Donation Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Counter_for_New_Donation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Previous Donation</defaultConnectorLabel>
        <rules>
            <name>Previous_Donation_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Previous_Recurring_Donations.Recurring_Donation_Installment_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Counter_for_Existing_Donation</targetReference>
            </connector>
            <label>Previous Donation Exists</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Next_Installment_Number</name>
        <dataType>Number</dataType>
        <expression>{!Previous_Recurring_Donations.Recurring_Donation_Installment_Number__c}+1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>RecurringName</name>
        <dataType>String</dataType>
        <expression>{!Get_Account_Details.Name} &amp; &quot; -R Donation &quot; &amp; 
TEXT(DAY({!$Record.TransactionDueDate})) &amp; &quot;-&quot; &amp; 
TEXT(MONTH({!$Record.TransactionDueDate})) &amp; &quot;-&quot; &amp; 
TEXT(YEAR({!$Record.TransactionDueDate}))</expression>
    </formulas>
    <interviewLabel>increment installments {!$Flow.CurrentDateTime}</interviewLabel>
    <label>increment installments</label>
    <loops>
