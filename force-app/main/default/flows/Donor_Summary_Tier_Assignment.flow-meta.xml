<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Account_Found</name>
        <label>Account Found?</label>
        <locationX>644</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_New_Tier_Rule</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Current_Tier</name>
        <label>Has Current Tier?</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Tier_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Tier</defaultConnectorLabel>
        <rules>
            <name>Tier_Is_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Account.Donor_Tier__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Tier</targetReference>
            </connector>
            <label>Blank</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_Rule_Found</name>
        <label>New Rule Found?</label>
        <locationX>358</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>Rule_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_New_Tier_Rule</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Current_Tier</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tier_Changed</name>
        <label>Tier Changed?</label>
        <locationX>226</locationX>
        <locationY>863</locationY>
        <defaultConnectorLabel>Same Tier</defaultConnectorLabel>
        <rules>
            <name>Different_Tier</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_New_Tier_Rule.Tier_Value__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Donor_Account.Donor_Tier__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Tier</targetReference>
            </connector>
            <label>Different Tier</label>
        </rules>
    </decisions>
    <description>When a Donor Gift Summary&apos;s TotalGiftsAmount changes, looks up the matching active Donor_Tier_Rule__mdt record and updates the donor Account&apos;s Donor_Tier__c whenever the newly calculated tier differs from the donor&apos;s current tier. Upgrades and downgrades the donor.</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns zero when TotalGiftsAmount is blank or negative; otherwise the original amount.</description>
        <name>NormalizedAmount</name>
        <dataType>Number</dataType>
        <expression>IF( OR( ISNULL({!$Record.TotalGiftsAmount}), {!$Record.TotalGiftsAmount} &lt; 0 ), 0, {!$Record.TotalGiftsAmount} )</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Donor Summary - Tier Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Donor Summary - Tier Assignment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Donor_Account</name>
        <label>Get Donor Account</label>
        <locationX>644</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Account_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.DonorId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsPersonAccount</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Tier_Rule</name>
        <label>Get New Tier Rule</label>
        <locationX>358</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>New_Rule_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Minimum_Amount__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>NormalizedAmount</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Donor_Tier_Rule__mdt</object>
        <sortField>Minimum_Amount__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account_Tier</name>
        <label>Update Account Tier</label>
        <locationX>50</locationX>
        <locationY>1355</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Donor_Account.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Donor_Tier__c</field>
            <value>
                <elementReference>Get_New_Tier_Rule.Tier_Value__c</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>518</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Donor_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TotalGiftsAmount</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>DonorId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>DonorGiftSummary</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
