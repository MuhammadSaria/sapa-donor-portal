<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_the_donation_fields</name>
        <label>Assign the donation fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>DonationRecord.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>paid</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Related_Donation.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.Transaction_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Transaction_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.PaymentMethod</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Payment_Method__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.Payment_Profile_ID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Payment_Profile_Id__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.TransactionDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TodaysDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.PaymentMethod</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Credit Card</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.Charge_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Charge_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_status_decision</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Copy_2_of_Assign_the_donation_fields</name>
        <label>Assign the donation fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>DonationRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Related_Donation.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.PaymentMethod</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Payment_Method__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DonationRecord.Payment_Profile_ID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Payment_Profile_Id__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Copy_2_of_Update_Related_Donation</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>If_created_payment_has_donation</name>
        <label>If created &amp; payment has donation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_payment_has_donation1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Donation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Related_Donation</targetReference>
            </connector>
            <label>If payment has donation</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Prior_paid_false_and_paid_true</name>
        <label>If Prior paid = false and paid =true</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_2_of_Update_Related_Donation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Prior_paid_False_Donation_has_value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Paid__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Paid__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_the_donation_fields</targetReference>
            </connector>
            <label>Prior paid = False &amp; Donation has value</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_status_decision</name>
        <label>Update status decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_2_of_Update_Related_Donation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Recurring_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Recurring_Donation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_RD_for_Status_Reason</targetReference>
            </connector>
            <label>Recurring not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Updated_and_Paid_Decision</name>
        <label>Updated and Paid Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>If_Prior_paid_false_and_paid_true</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Unpaid1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Paid__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Assign_the_donation_fields</targetReference>
            </connector>
            <label>Unpaid</label>
        </rules>
    </decisions>
    <description>Added charge Id on donation</description>
    <environments>Default</environments>
    <formulas>
        <name>TodaysDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Payment Object Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Payment Trigger Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Related_Donation</name>
        <label>Get Related Donation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Updated_and_Paid_Decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Donation__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GiftTransaction</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Copy_2_of_Update_Related_Donation</name>
        <label>Update Related Donation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>DonationRecord</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_RD_for_Status_Reason</name>
        <label>Update RD for Status Reason</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Copy_2_of_Update_Related_Donation</targetReference>
        </connector>
        <inputAssignments>
            <field>ClosedReason__c</field>
        </inputAssignments>
        <inputReference>$Record.Recurring_Donation__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_created_payment_has_donation</targetReference>
        </connector>
        <object>Payment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>DonationRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>GiftTransaction</objectType>
    </variables>
</Flow>
