<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Extract_and_Update</name>
        <label>Extract and Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_LocationCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>form_ParsedValue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_RemainingText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>form_NewRemainingText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Check_for_Semicolon</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>The_Initial_Assignment</name>
        <label>The Initial Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_RemainingText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>form_InitialText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_for_Semicolon</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_for_Semicolon</name>
        <label>Check for Semicolon</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Done Parsing</defaultConnectorLabel>
        <rules>
            <name>Has_Semicolon</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_RemainingText</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>;</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Extract_and_Update</targetReference>
            </connector>
            <label>Has Semicolon</label>
        </rules>
    </decisions>
    <description>Added location</description>
    <environments>Default</environments>
    <formulas>
        <name>form_InitialText</name>
        <dataType>String</dataType>
        <expression>{!location} + &quot;;&quot;</expression>
    </formulas>
    <formulas>
        <name>form_NewRemainingText</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT({!var_RemainingText}, LEN({!var_RemainingText}) - FIND(&quot;;&quot;, {!var_RemainingText})))</expression>
    </formulas>
    <formulas>
        <name>form_ParsedValue</name>
        <dataType>String</dataType>
        <expression>TRIM(LEFT({!var_RemainingText}, FIND(&quot;;&quot;, {!var_RemainingText}) - 1))</expression>
    </formulas>
    <interviewLabel>fundID {!$Flow.CurrentDateTime}</interviewLabel>
    <label>fundID</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Fund</name>
        <label>Fund</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>The_Initial_Assignment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>fundId</elementReference>
            </value>
        </filters>
        <object>GiftDesignation</object>
        <outputAssignments>
            <assignToReference>location</assignToReference>
            <field>Location__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>funds</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Fund</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
