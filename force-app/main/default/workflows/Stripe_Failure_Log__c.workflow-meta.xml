<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Stripe_Failure_Alert</fullName>
        <description>Emails the Stripe Support group about a new or reopened Stripe failure log. Called from the Stripe_Failure_Log_Notify flow.</description>
        <protected>false</protected>
        <recipients>
            <recipient>Stripe_Support</recipient>
            <type>group</type>
        </recipients>
        <senderAddress>donorcare@sapa-usa.org</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>Stripe_Notifications/Stripe_Failure_Alert</template>
    </alerts>
</Workflow>
